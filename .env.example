# TRADECRAFT Environment Configuration Template
# Copy this file to .env or .env.local and fill in your development / production credentials.
# DO NOT COMMIT ACTUAL SECRETS TO GIT.

# ============================================================
# SUPABASE AUTH & DATABASE CONFIGURATION
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# GOOGLE OAUTH CONFIGURATION (Configured inside Supabase Auth Dashboard)
# ============================================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================
# OPTIONAL AI MENTOR LLM PROXY API KEY
# (If not provided, the AI Mentor operates using the local RuleBasedMentorProvider)
# ============================================================
VITE_AI_MENTOR_API_KEY=your-ai-mentor-api-key-here
